{
  "manifest_version": 3,
  "name": "Simple Drawing Extension",
  "version": "1.0",
  "description": "Draw on any website with your mouse or graphic tablet pen.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}